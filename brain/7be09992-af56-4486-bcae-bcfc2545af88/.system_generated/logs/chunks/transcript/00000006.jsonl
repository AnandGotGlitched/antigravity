ght(joystickInput.x * speed);\\n                viewer.scene.camera.rotateUp(joystickInput.y * speed);\\n            }\\n            // Idle auto-rotation\\n            else if (!viewer.trackedEntity && (Date.now() - lastInteractionTime > 4000)) {\\n                viewer.scene.camera.rotateRight(0.0003);\\n            }\\n        });\"","StartLine":"99","TargetContent":"\"        // Intelligent Auto-Rotation\\n        let lastInteractionTime = 0;\\n        \\n        viewer.scene.canvas.addEventListener('pointerdown', () => lastInteractionTime = Date.now());\\n        viewer.scene.canvas.addEventListener('wheel', () => lastInteractionTime = Date.now());\\n\\n        viewer.clock.onTick.addEventListener(() => {\\n            if (!viewer.trackedEntity && (Date.now() - lastInteractionTime > 4000)) {\\n                viewer.scene.camera.rotateRight(0.0003);\\n            }\\n        });\"","TargetFile":"\"/Users/anandgopaltiwary/.gemini/antigravity/scratch/space_debris_prototype/frontend/app.js\"","toolAction":"\"Adding joystick camera controls\"","toolSummary":"\"Joystick + camera binding\""}}]}
