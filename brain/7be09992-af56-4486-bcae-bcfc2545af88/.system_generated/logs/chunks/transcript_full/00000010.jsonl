88:     inputTime.addEventListener('input', (e) => {\n789:         const val = e.target.value;\n790:         valTime.textContent = val === '1' ? '1 year' : `${val} years`;\n791:     });\n792: \n793:     calculateBtn.addEventListener('click', async () => {\n794:         const alt = parseFloat(inputAltitude.value);\n795:         const area = parseFloat(inputArea.value);\n796:         const time = parseFloat(inputTime.value);\n797: \n798:         try {\n799:             const res = await fetch('http://127.0.0.1:8000/api/mission-risk', {\n800:                 method: 'POST',\n801:                 headers: { 'Content-Type': 'application/json' },\n802:                 body: JSON.stringify({\n803:                     altitude_km: alt,\n804:                     area_m2: area,\n805:                     time_years: time\n806:                 })\n807:             });\n808:             const data = await res.json();\n809:             \n810:             const percentage = data.probability_percentage;\n811: \n812:             animateValue(probValue, parseFloat(probValue.textContent) || 0, percentage, 1000);\n813:             \n814:             riskMeterFill.style.width = `${Math.min(percentage, 100)}%`;\n815: \n816:             setTimeout(() => {\n817:                 if (data.risk_rating === 'HIGH') {\n818:                     riskBadge.textContent = 'HIGH';\n819:                     riskBadge.className = 'px-3 py-0.5 border border-red-500 bg-red-600/20 text-red-400 rounded-sm font-bold shadow-[0_0_10px_rgba(220,38,38,0.8)] animate-pulse';\n820:                     riskMeterFill.className = 'h-full bg-red-500 transition-all duration-1000 ease-out shadow-[0_0_15px_rgba(239,68,68,0.8)]';\n821:                     probValue.className = 'text-6xl font-light tracking-wider font-mono text-red-400 drop-shadow-[0_0_15px_rgba(239,68,68,0.8)] transition-all duration-500';\n822:                 } else if (data.risk_rating === 'MODERATE') {\n823:                     riskBadge.textContent = 'MODERATE';\n824:                     riskBadge.className = 'px-3 py-0.5 border border-yellow-500 bg-yellow-500/20 text-yellow-400 rounded-sm font-semibold';\n825:                     riskMeterFill.className = 'h-full bg-yellow-400 transition-all duration-1000 ease-out shadow-[0_0_10px_rgba(250,204,21,0.5)]';\n826:                     probValue.className = 'text-6xl font-light tracking-wider font-mono text-yellow-400 drop-shadow-[0_0_15px_rgba(250,204,21,0.5)] transition-all duration-500';\n827:                 } else {\n828:                     riskBadge.textContent = 'LOW';\n829:                     riskBadge.className = 'px-3 py-0.5 border border-green-500 bg-green-500/20 text-green-400 rounded-sm font-semibold';\n830:                     riskMeterFill.className = 'h-full bg-green-400 transition-all duration-1000 ease-out shadow-[0_0_10px_rgba(74,222,128,0.5)]';\n831:                     probValue.className = 'text-6xl font-light tracking-wider font-mono text-green-400 drop-shadow-[0_0_15px_rgba(74,222,128,0.5)] transition-all duration-500';\n832:                 }\n833:             }, 100);\n834:         } catch(e) {\n835:             console.error(e);\n836:         }\n837:     });\n838: \n839:     function animateValue(obj, start, end, duration) {\n840:         let startTimestamp = null;\n841:         const step = (timestamp) => {\n842:             if (!startTimestamp) startTimestamp = timestamp;\n843:             const progress = Math.min((timestamp - startTimestamp) / duration, 1);\n844:             const currentVal = (progress * (end - start) + start).toFixed(2);\n845:             obj.innerHTML = currentVal + '<span class=\"text-3xl text-gray-400 ml-1\">%</span>';\n846:             if (progress < 1) {\n847:                 window.requestAnimationFrame(step);\n848:             } else {\n849:                 obj.innerHTML = end.toFixed(2) + '<span class=\"text-3xl text-gray-400 ml-1\">%</span>';\n850:             }\n851:         };\n852:         window.requestAnimationFrame(step);\n853:     }\n854: });\n855: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
{"step_index":373,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-27T08:30:58Z","content":"Now I'll add the `generateConjunctionReport` function and wire up both export buttons. I'll insert the report function and button bindings right before the Risk Calculator section:","tool_calls":[{"name":"replace_file_content","args":{"AllowMultiple":false,"Description":"Add the generateConjunctionReport PDF function and wire up both export buttons (header + CAM drawer).","EndLine":770,"Instruction":"Add PDF generation function and button event listeners before the Risk Calculator section.","ReplacementContent":"    refreshBtn.addEventListener('click', fetchConjunctionData);\n    \n    // Initial fetch for Live Tracking\n    fetchConjunctionData();\n\n\n    // --- PDF REPORT GENERATION ---\n    function generateConjunctionReport(eventData, camData) {\n        const { jsPDF } = window.jspdf;\n        const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });\n\n        const eventId = `CAR-${new Date().getFullYear()}-${Math.floor(1000 + Math.random() * 9000)}`;\n        const generatedAt = new Date().toISOString().replace('T', ' ').substring(0, 19) + ' UTC';\n        const pageWidth = doc.internal.pageSize.getWidth();\n\n        // --- Background ---\n        doc.setFillColor(15, 23, 42); // slate-900\n        doc.rect(0, 0, pageWidth, 297, 'F');\n\n        // --- Header Bar ---\n        doc.setFillColor(30, 41, 59); // slate-800\n        doc.rect(0, 0, pageWidth, 38, 'F');\n\n        // Cyan accent line\n        doc.setDrawColor(6, 182, 212);\n        doc.setLineWidth(0.8);\n        doc.line(0, 38, pageWidth, 38);\n\n        doc.setFont('helvetica', 'bold');\n        doc.setFontSize(14);\n        doc.setTextColor(6, 182, 212);\n        doc.text('ORBITAL GUARD', 15, 14);\n\n        doc.setFontSize(9);\n        doc.setTextColor(148, 163, 184); // slate-400\n        doc.text('// CONJUNCTION ASSESSMENT REPORT (CAR)', 15, 21);\n\n        // Document metadata\n        doc.setFontSize(8);\n        doc.setTextColor(100, 116, 139);\n        doc.text(`Document ID: ${eventId}`, 15, 30);\n        doc.text(`Generated: ${generatedAt}`, 15, 35);\n\n        // Classification badge\n        doc.setFillColor(6, 182, 212);\n        doc.roundedRect(pageWidth - 80, 10, 65, 8, 1, 1, 'F');\n        doc.setFontSize(6);\n        doc.setTextColor(15, 23, 42);\n        doc.setFont('helvetica', 'bold');\n        doc.text('UNCLASSIFIED / OPERATIONAL BRIEF', pageWidth - 78, 15);\n\n        let y = 50;\n\n        // --- Helper: Section Title ---\n        function sectionTitle(title) {\n            doc.setFillColor(30, 41, 59);\n            doc.rect(15, y - 5, pageWidth - 30, 9, 'F');\n            doc.setDrawColor(6, 182, 212);\n            doc.setLineWidth(0.3);\n            doc.line(15, y + 4, pageWidth - 15, y + 4);\n            doc.setFont('helvetica', 'bold');\n            doc.setFontSize(9);\n            doc.setTextColor(6, 182, 212);\n            doc.text(title, 18, y + 1);\n            y += 12;\n        }\n\n        // --- Helper: Table Row ---\n        function tableRow(label, value) {\n            doc.setFont('helvetica', 'normal');\n            doc.setFontSize(9);\n            doc.setTextColor(148, 163, 184);\n            doc.text(label, 20, y);\n            doc.setFont('helvetica', 'bold');\n            doc.setTextColor(226, 232, 240); // slate-200\n            doc.text(String(value), 90, y);\n            y += 7;\n        }\n\n        // === SECTION 1: EVENT SUMMARY ===\n        sectionTitle('SECTION 1: EVENT SUMMARY');\n\n        const tcaDate = eventData.closest_approach_time\n            ? new Date(eventData.closest_approach_time).toISOString().replace('T', ' ').substring(0, 19) + ' UTC'\n            : 'N/A';\n        const pc = eventData.collision_probability || '1.42e-4';\n\n        tableRow('Primary Object', eventData.object1 || '--');\n        tableRow('Secondary Object', eventData.object2 || '--');\n        tableRow('NORAD ID (Primary)', (eventData.object1 || '').split(' ').pop() || '--');\n        tableRow('NORAD ID (Secondary)', (eventData.object2 || '').split(' ').pop() || '--');\n        tableRow('Time of Closest Approach', tcaDate);\n        tableRow('Miss Distance (d)', `${(eventData.min_distance_km || 0).toFixed(2)} km`);\n        tableRow('Collision Probability (Pc)', String(pc));\n\n        y += 5;\n\n        // === SECTION 2: RISK ASSESSMENT ===\n        sectionTitle('SECTION 2: RISK ASSESSMENT');\n\n        const risk = eventData.risk_level || 'NOMINAL';\n        doc.setFont('helvetica', 'normal');\n        doc.setFontSize(9);\n        doc.setTextColor(148, 163, 184);\n        doc.text('Risk Classification:', 20, y);\n\n        // Risk badge\n        if (risk === 'CRITICAL') {\n            doc.setFillColor(185, 28, 28);\n            doc.setTextColor(255, 255, 255);\n        } else if (risk === 'Medium') {\n            doc.setFillColor(161, 98, 7);\n            doc.setTextColor(255, 255, 255);\n        } else {\n            doc.setFillColor(21, 128, 61);\n            doc.setTextColor(255, 255, 255);\n        }\n        doc.roundedRect(90, y - 4, 25, 7, 1, 1, 'F');\n        doc.setFont('helvetica', 'bold');\n        doc.setFontSize(7);\n        doc.text(risk, 92, y);\n        y += 10;\n\n        doc.setFont('helvetica', 'normal');\n        doc.setFontSize(8);\n        doc.setTextColor(148, 163, 184);\n        if (risk === 'CRITICAL') {\n            doc.text('Assessment: Collision probability exceeds the actionable threshold of Pc > 1.0e-4.', 20, y);\n            y += 5;\n            doc.text('Immediate conjunction response action is RECOMMENDED per JSpOC/18 SPCS guidelines.', 20, y);\n        } else {\n            doc.text('Assessment: Collision probability remains below the actionable threshold of Pc > 1.0e-4.', 20, y);\n            y += 5;\n            doc.text('No immediate conjunction response action required. Continue monitoring.', 20, y);\n        }\n        y += 12;\n\n        // === SECTION 3: CAM (if provided) ===\n        if (camData) {\n            sectionTitle('SECTION 3: RECOMMENDED COLLISION AVOIDANCE MANEUVER');\n\n            tableRow('Burn Direction', camData.direction || 'Prograde');\n            tableRow('In-Track Delta-v', `${camData.deltaV} m/s`);\n            tableRow('Propulsion Type', camData.propulsionType || 'Chemical (Hydrazine)');\n            tableRow('Propellant Mass Penalty', `${camData.fuelCost} kg`);\n            tableRow('Post-Maneuver Miss Distance', `${camData.newDist} km`);\n            tableRow('Post-Maneuver Pc', camData.newPc);\n            tableRow('Post-Maneuver Status', camData.newDist > 50 ? 'SAFE' : 'CRITICAL');\n\n            y += 5;\n        }\n\n        // === FOOTER ===\n        // Cyan divider\n        doc.setDrawColor(6, 182, 212);\n        doc.setLineWidth(0.4);\n        doc.line(15, 265, pageWidth - 15, 265);\n\n        doc.setFont('helvetica', 'italic');\n        doc.setFontSize(6.5);\n        doc.setTextColor(100, 116, 139);\n        doc.text(\n            'Propagated via SGP4 analytical theory & 2D Gaussian B-Plane integral.',\n            15, 271\n        );\n        doc.text(\n            'Certified for Space Situational Awareness (SSA) flight dynamics handoff.',\n            15, 275\n        );\n        doc.text(\n            `ORBITAL GUARD v1.0  |  ${eventId}  |  ${generatedAt}`,\n            15, 280\n        );\n\n        // Trigger download\n        doc.save(`OrbitalGuard_${eventId}.pdf`);\n    }\n\n    // --- EXPORT BUTTON WIRING ---\n\n    // Header button: export from cached conjunction data (highest risk)\n    document.getElementById('exportReportBtn').addEventListener('click', () => {\n        let conj = null;\n        if (window._cachedConjunctions) {\n            conj = window._cachedConjunctions.find(c => c.risk_level === 'CRITICAL') || window._cachedConjunctions[0];\n        }\n        if (conj) {\n            generateConjunctionReport(conj, null);\n        }\n    });\n\n    // CAM Drawer button: export with maneuver data\n    document.getElementById('exportCamReportBtn').addEventListener('click', () => {\n        let conj = null;\n        if (window._cachedConjunctions) {\n            conj = window._cachedConjunctions.find(c => c.risk_level === 'CRITICAL') || window._cachedConjunctions[0];\n        }\n        if (conj) {\n            const dv = parseFloat(camDeltaVSlider.value);\n            const isElectric = camPropulsionSelect.value === 'electric';\n            const costMultiplier = isElectric ? 0.2 : 3.5;\n            const camData = {\n                direction: isPrograde ? 'Prograde' : 'Retrograde',\n                deltaV: dv.toFixed(1),\n                propulsionType: isElectric ? 'Electric (Ion)' : 'Chemical (Hydrazine)',\n                fuelCost: (dv * costMultiplier).toFixed(1),\n                newDist: (currentOriginalDist + dv * 500).toFixed(1),\n                newPc: dv === 0 ? (conj.collision_probability || '1.42e-4') : (parseFloat(conj.collision_probability || '1.42e-4') * Math.exp(-dv * 3)).toExponential(2)\n            };\n            generateConjunctionReport(conj, camData);\n        }\n    });","StartLine":766,"TargetContent":"    refreshBtn.addEventListener('click', fetchConjunctionData);\n    \n    // Initial fetch for Live Tracking\n    fetchConjunctionData();","TargetFile":"/Users/anandgopaltiwary/.gemini/antigravity/scratch/space_debris_prototype/frontend/app.js","toolAction":"Adding PDF generation code","toolSummary":"PDF report generation"}}]}
