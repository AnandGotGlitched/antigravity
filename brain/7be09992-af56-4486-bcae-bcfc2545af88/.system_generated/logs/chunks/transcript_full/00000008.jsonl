ctiveTCA);\n326:                 viewer.clock.currentTime = tcaJD;\n327:                 viewer.clock.shouldAnimate = false;\n328:                 btnPlayPause.innerHTML = '► Play';\n329:                 const diff = Cesium.JulianDate.secondsDifference(tcaJD, baseTime);\n330:                 const offsetHours = diff / 3600;\n331:                 temporalScrubber.value = Math.max(-12, Math.min(12, offsetHours));\n332:                 temporalTimeLabel.textContent = formatScrubberLabel(offsetHours, tcaJD);\n333:             } else {\n334:                 alert('No conjunction selected. Click a row in Live Tracking first.');\n335:             }\n336:         });\n337: \n338:         // === PROXIMITY ALERT SYSTEM ===\n339:         let proximityLine = null;\n340:         let activeConjunctionPair = null; // {obj1: name, obj2: name}\n341:         window.setActiveConjunctionPair = (obj1, obj2) => { activeConjunctionPair = { obj1, obj2 }; };\n342: \n343:         viewer.clock.onTick.addEventListener(() => {\n344:             if (!activeConjunctionPair) return;\n345:             \n346:             const e1 = satelliteEntities[activeConjunctionPair.obj1];\n347:             const e2 = satelliteEntities[activeConjunctionPair.obj2];\n348:             if (!e1 || !e2) return;\n349: \n350:             const pos1 = e1.position.getValue(viewer.clock.currentTime);\n351:             const pos2 = e2.position.getValue(viewer.clock.currentTime);\n352:             if (!pos1 || !pos2) return;\n353: \n354:             const distance = Cesium.Cartesian3.distance(pos1, pos2) / 1000; // to km\n355: \n356:             if (distance < 50) {\n357:                 // Draw or update red proximity laser\n358:                 if (!proximityLine) {\n359:                     proximityLine = viewer.entities.add({\n360:                         name: 'PROXIMITY_LINE',\n361:                         polyline: {\n362:                             positions: new Cesium.CallbackProperty(() => {\n363:              