000057  00000-0  34487-4 0  9992\",\n31:         \"line2\": \"2 27386  98.1504 290.4137 0001221  85.7628 274.3755 14.37910976135245\"\n32:     }\n33: ]\n34: \n35: def calculate_distance(pos1, pos2):\n36:     return math.sqrt(\n37:         (pos1[0] - pos2[0])**2 +\n38:         (pos1[1] - pos2[1])**2 +\n39:         (pos1[2] - pos2[2])**2\n40:     )\n41: \n42: def find_close_approaches(hours=24, step_minutes=5):\n43:     \"\"\"\n44:     Calculates close approaches between the given TLE objects.\n45:     Returns a list of dictionaries with closest approach details.\n46:     \"\"\"\n47:     satellites = []\n48:     for item in TLE_DATA:\n49:         sat = Satrec.twoline2rv(item[\"line1\"], item[\"line2\"])\n50:         satellites.append({\"name\": item[\"name\"], \"satrec\": sat})\n51: \n52:     start_time = datetime.utcnow()\n53:     end_time = start_time + timedelta(hours=hours)\n54:     \n55:     # Generate time steps\n56:     time_steps = []\n57:     current_time = start_time\n58:     while current_time <= end_time:\n59:         time_steps.append(current_time)\n60:         current_time += timedelta(minutes=step_minutes)\n61: \n62:     conjunctions = []\n63:     \n64:     # Check all pairs\n65:     for i in range(len(satellites)):\n66:         for j in range(i + 1, len(satellites)):\n67:             sat1 = satellites[i]\n68:             sat2 = satellites[j]\n69:             \n70:             min_dist = float('inf')\n71:             closest_time = None\n72:             \n73:             for t in time_steps:\n74:                 # jd, fr = jday(t.year, t.month, t.day, t.hour, t.minute, t.second)\n75:                 e1, r1, v1 = sat1[\"satrec\"].sgp4(t.year, t.month, t.day, t.hour, t.minute, t.second)\n76:                 e2, r2, v2 = sat2[\"satrec\"].sgp4(t.year, t.month, t.day, t.hour, t.minute, t.second)\n77:                 \n78:                 # e = 0 means success in sgp4 propagation\n79:                 if e1 == 0 and e2 == 0:\n80:                     dist = calculate_distance(r1, r2)\n81:                     if dist < min_dist:\n82:                         min_dist = dist\n83:                         closest_time = t\n84: \n85:             if closest_time:\n86:                  conjunctions.append({\n87:                     \"object1\": sat1[\"name\"],\n88:                     \"object2\": sat2[\"name\"],\n89:                     \"min_distance_km\": round(min_dist, 2),\n90:                     \"closest_approach_time\": closest_time.isoformat(),\n91:                     \"risk_level\": \"High\" if min_dist < 50 else (\"Medium\" if min_dist < 200 else \"Low\")\n92:                  })\n93:                  \n94:     # Sort by minimum distance\n95:     conjunctions.sort(key=lambda x: x[\"min_distance_km\"])\n96:     return conjunctions\n97: \nThe above content shows the entire, complete file contents of the requested file.\n"}
