rsor-pointer\">\n                            <thead>\n                                <tr class=\"bg-white/5 border-b border-white/10 text-gray-300 text-xs uppercase tracking-widest\">\n                                    <th class=\"p-5 font-semibold\">Primary Object</th>\n                                    <th class=\"p-5 font-semibold\">Secondary Object</th>\n                                    <th class=\"p-5 font-semibold\">Time of Approach (UTC)</th>\n                                    <th class=\"p-5 font-semibold text-right\">Distance (km)</th>\n                                    <th class=\"p-5 font-semibold text-center\">Status</th>\n                                </tr>\n                            </thead>\n                            <tbody id=\"conjunctionTableBody\" class=\"divide-y divide-white/5 text-sm\">\n                                <!-- Rows injected here via JS -->\n                            </tbody>\n                        </table>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- ============================== -->\n        <!-- VIEW 3D: ORBIT VIEWER          -->\n        <!-- ============================== -->\n        <div id=\"view3D\" class=\"hidden w-full h-[600px] animate-glide-up bg-black/40 backdrop-blur-md border border-white/10 shadow-2xl overflow-hidden\">\n            <div id=\"cesiumContainer\" class=\"w-full h-full\"></div>\n        </div>","StartLine":74,"TargetContent":"        <!-- ============================== -->\n        <!-- VIEW 1: LIVE TRACKING TABLE    -->\n        <!-- ============================== -->\n        <div id=\"viewLive\" class=\"w-full animate-glide-up\">\n            <!-- Loader -->\n            <div id=\"loader\" class=\"flex justify-center items-center py-20 w-full\">\n                <div class=\"animate-spin rounded-full h-12 w-12 border-b-2 border-white\"></div>\n            </div>\n\n            <!-- Error State -->\n            <div id=\"errorState\" class=\"hidden w-full bg-red-900/50 backdrop-blur-md border border-red-500/50 text-red-200 p-6 mb-6\">\n                <div class=\"flex items-center space-x-3 text-lg\">\n                    <i class=\"fa-solid fa-triangle-exclamation\"></i>\n                    <span id=\"errorMessage\">Failed to load data from the server.</span>\n                </div>\n            </div>\n\n            <!-- Data Table -->\n            <div id=\"dashboardContent\" class=\"hidden w-full\">\n                <div class=\"bg-black/40 backdrop-blur-md border border-white/10 shadow-2xl overflow-hidden\">\n                    <div class=\"overflow-x-auto\">\n                        <table class=\"w-full text-left border-collapse whitespace-nowrap\">\n                            <thead>\n                                <tr class=\"bg-white/5 border-b border-white/10 text-gray-300 text-xs uppercase tracking-widest\">\n                                    <th class=\"p-5 font-semibold\">Primary Object</th>\n                                    <th class=\"p-5 font-semibold\">Secondary Object</th>\n                                    <th class=\"p-5 font-semibold\">Time of Approach (UTC)</th>\n                                    <th class=\"p-5 font-semibold text-right\">Distance (km)</th>\n                                    <th class=\"p-5 font-semibold text-center\">Status</th>\n                                </tr>\n                            </thead>\n                            <tbody id=\"conjunctionTableBody\" class=\"divide-y divide-white/5 text-sm\">\n                                <!-- Rows injected here via JS -->\n                            </tbody>\n                        </table>\n                    </div>\n                </div>\n            </div>\n        </div>","TargetFile":"/Users/anandgopaltiwary/.gemini/antigravity/scratch/space_debris_prototype/frontend/index.html","toolAction":"Adding view3D container","toolSummary":"Add view3D div"}}]}
