ONJUNCTION ASSESSMENT REPORT (CAR)', 15, 21);\\n\\n        // Document metadata\\n        doc.setFontSize(8);\\n        doc.setTextColor(100, 116, 139);\\n        doc.text(`Document ID: ${eventId}`, 15, 30);\\n        doc.text(`Generated: ${generatedAt}`, 15, 35);\\n\\n        // Classification badge\\n        doc.setFillColor(6, 182, 212);\\n        doc.roundedRect(pageWidth - 80, 10, 65, 8, 1, 1, 'F');\\n        doc.setFontSize(6);\\n        doc.setTextColor(15, 23, 42);\\n        doc.setFont('helvetica', 'bold');\\n        doc.text('UNCLASSIFIED / OPERATIONAL BRIEF', pageWidth - 78, 15);\\n\\n        let y = 50;\\n\\n        // --- Helper: Section Title ---\\n        function sectionTitle(title) {\\n            doc.setFillColor(30, 41, 59);\\n   \n<truncated 6514 bytes>","StartLine":"766","TargetContent":"\"    refreshBtn.addEventListener('click', fetchConjunctionData);\\n    \\n    // Initial fetch for Live Tracking\\n    fetchConjunctionData();\"","TargetFile":"\"/Users/anandgopaltiwary/.gemini/antigravity/scratch/space_debris_prototype/frontend/app.js\"","toolAction":"\"Adding PDF generation code\"","toolSummary":"\"PDF report generation\""}}],"truncated_fields":["tool_calls"]}
