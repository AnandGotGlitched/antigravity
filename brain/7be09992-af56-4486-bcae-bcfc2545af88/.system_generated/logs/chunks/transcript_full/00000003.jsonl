en');\n            if (!cesiumInitialized) {\n                initCesium();\n                cesiumInitialized = true;\n            } else {\n                // Resize viewer when unhidden and resume render loop\n                if (window.viewer) {\n                    window.viewer.useDefaultRenderLoop = true;\n                    window.viewer.resize();\n                }\n            }\n        } else if (activeTab === tabCalc) {\n            viewCalc.classList.remove('hidden');\n            refreshBtn.classList.add('hidden');\n            if (window.viewer) window.viewer.useDefaultRenderLoop = false;\n        }","StartLine":29,"TargetContent":"        if (activeTab === tabLive) {\n            viewLive.classList.remove('hidden');\n            refreshBtn.classList.remove('hidden');\n        } else if (activeTab === tab3D) {\n            view3D.classList.remove('hidden');\n            refreshBtn.classList.add('hidden');\n            if (!cesiumInitialized) {\n                initCesium();\n                cesiumInitialized = true;\n            } else {\n                // Resize viewer when unhidden\n                if(window.viewer) window.viewer.resize();\n            }\n        } else if (activeTab === tabCalc) {\n            viewCalc.classList.remove('hidden');\n            refreshBtn.classList.add('hidden');\n        }","TargetFile":"/Users/anandgopaltiwary/.gemini/antigravity/scratch/space_debris_prototype/frontend/app.js","toolAction":"Fixing Cesium tab switching","toolSummary":"Cesium resizing fix"}}]}
