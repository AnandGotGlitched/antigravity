teEntities[conj.object2];\\n\\n            if (e1 && e2) {\\n                const pos1 = e1.position.getValue(tcaJD);\\n                const pos2 = e2.position.getValue(tcaJD);\\n\\n                if (pos1 && pos2) {\\n                    // Calculate midpoint\\n                    const midpoint = Cesium.Cartesian3.midpoint(pos1, pos2, new Cesium.Cartesian3());\\n                    \\n                    // Fly camera to frame both objects\\n                    viewer.trackedEntity = undefined;\\n                    viewer.camera.flyTo({\\n                        destination: Cesium.Cartesian3.add(midpoint, new Cesium.Cartesian3(200000, -200000, 200000), new Cesium.Cartesian3()),\\n                        orientation: {\\n                            direction: Cesium.Cartesian3.normalize(Cesium.Cartesian3.subtract(midpoint, Cesium.Cartesian3.add(midpoint, new Cesium.Cartesian3(200000, -200000, 200000), new Cesium.Cartesian3()), new Cesium.Cartesian3()), new Cesium.Cartesian3()),\\n                            up: Cesium.Cartesian3.UNIT_Z\\n                        },\\n                        duration: 2.0\\n                    });\"","TargetFile":"\"/Users/anandgopaltiwary/.gemini/antigravity/scratch/space_debris_prototype/frontend/app.js\"","toolAction":"\"Fixing TCA camera framing\"","toolSummary":"\"Safe BoundingSphere flyTo\""}}]}
