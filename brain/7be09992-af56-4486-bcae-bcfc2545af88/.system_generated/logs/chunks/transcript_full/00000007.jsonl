ha(0.4)\n164:                         },\n165:                         label: {\n166:                             text: sat.name,\n167:                             font: '12pt Inter',\n168:                             fillColor: Cesium.Color.WHITE,\n169:                             style: Cesium.LabelStyle.FILL_AND_OUTLINE,\n170:                             outlineWidth: 2,\n171:                             verticalOrigin: Cesium.VerticalOrigin.BOTTOM,\n172:                             pixelOffset: new Cesium.Cartesian2(0, -9)\n173:                         },\n174:                         properties: {\n175:                             catalogId: sat.name.split(' ').pop() || \"UNKNOWN\",\n176:                             altitude: (height/1000).toFixed(0),\n177:                             velocity: (currentPosAndVel.velocity ? Math.sqrt(Math.pow(currentPosAndVel.velocity.x, 2) + Math.pow(currentPosAndVel.velocity.y, 2) + Math.pow(currentPosAndVel.velocity.z, 2)).toFixed(2) : \"7.62\"),\n178:                             riskLevel: isDebris ? \"CRITICAL\" : \"NOMINAL\"\n179:                         }\n180:                     });\n181:                     \n182:                     satelliteEntities[sat.name] = entity;\n183:                 }\n184:             });\n185:             \n186:         } catch (error) {\n187:             console.error(\"Error loading TLEs for Cesium:\", error);\n188:         }\n189: \n190:         // Click-to-Lock & Real-Time Tracking HUD\n191:         const handler = new Cesium.ScreenSpaceEventHandler(viewer.scene.canvas);\n192:         const telemetryHud = document.getElementById('telemetryHud');\n193:         const hudName = document.getElementById('hudName');\n194:         const hudId = document.getElementById('hudId');\n195:         const hudAlt = document.getElementById('hudAlt');\n196:         const hudVel = document.getElementById('hudVel');\n197:         const hudRisk = document.getElementById('hudRisk');\n198:         const close