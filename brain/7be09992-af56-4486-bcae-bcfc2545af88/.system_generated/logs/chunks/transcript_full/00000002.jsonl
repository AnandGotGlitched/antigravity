l lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Orbital Guard // Active Tracking</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap\" rel=\"stylesheet\">\n    <link href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css\" rel=\"stylesheet\">\n    <style>\n        body {\n            font-family: 'Inter', sans-serif;\n            background-color: #000;\n        }\n        .bg-cinematic {\n            background-image: linear-gradient(to bottom, rgba(0,0,0,0.4), rgba(0,0,0,0.85)), url('https://images.unsplash.com/photo-1614730321146-b6fa6a46bcb4?q=80&w=2000');\n            background-size: cover;\n            background-position: center;\n            background-attachment: fixed;\n        }\n        @keyframes glideUp {\n            0% { opacity: 0; transform: translateY(50px); }\n            100% { opacity: 1; transform: translateY(0); }\n        }\n        .animate-glide-up {\n            animation: glideUp 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n        }\n        \n        /* Custom scrollbar */\n        ::-webkit-scrollbar {\n            width: 8px;\n        }\n        ::-webkit-scrollbar-track {\n            background: rgba(255, 255, 255, 0.05);\n        }\n        ::-webkit-scrollbar-thumb {\n            background: rgba(255, 255, 255, 0.2);\n            border-radius: 4px;\n        }\n        ::-webkit-scrollbar-thumb:hover {\n            background: rgba(255, 255, 255, 0.3);\n        }\n    </style>\n</head>\n<body class=\"bg-cinematic text-white antialiased min-h-screen flex flex-col\">\n    \n    <!-- Minimalist Header -->\n    <header class=\"p-6 md:p-8 w-full z-10\">\n        <div class=\"container mx-auto flex items-center justify-between\">\n            <h1 class=\"text-xl md:text-3xl font-bold tracking-[0.2em] uppercase text-white shadow-sm\">\n                Orbital Guard <span class=\"text-gray-400 font-light\">// Active Tracking</span>\n            </h1>\n            <button id=\"refreshBtn\" class=\"border border-white/40 hover:bg-white/10 hover:border-white text-white px-5 py-2 transition duration-300 uppercase tracking-widest text-xs font-semibold rounded-none backdrop-blur-sm\">\n                Refresh Data\n            </button>\n        </div>\n    </header>\n\n    <!-- Main Content -->\n    <main class=\"flex-grow container mx-auto px-4 py-12 flex flex-col justify-center items-center relative z-10\">\n        \n        <!-- Loader -->\n        <div id=\"loader\" class=\"flex justify-center items-center py-20 w-full\">\n            <div class=\"animate-spin rounded-full h-12 w-12 border-b-2 border-white\"></div>\n        </div>\n\n        <!-- Error State -->\n        <div id=\"errorState\" class=\"hidden w-full max-w-5xl bg-red-900/50 backdrop-blur-md border border-red-500/50 text-red-200 p-6 mb-6\">\n            <div class=\"flex items-center space-x-3 text-lg\">\n                <i class=\"fa-solid fa-triangle-exclamation\"></i>\n                <span id=\"errorMessage\">Failed to load data from the server.</span>\n            </div>\n        </div>\n\n        <!-- Dashboard Grid / Table -->\n        <div id=\"dashboardContent\" class=\"hidden w-full max-w-6xl\">\n            <!-- Glassmorphism Container -->\n            <div class=\"bg-black/40 backdrop-blur-md border border-white/10 shadow-2xl overflow-hidden animate-glide-up\">\n                <div class=\"overflow-x-auto\">\n                    <table class=\"w-full text-left border-collapse whitespace-nowrap\">\n                        <thead>\n                            <tr class=\"bg-white/5 border-b border-white/10 text-gray-300 text-xs uppercase tracking-widest\">\n                                <th class=\"p-5 font-semibold\">Primary Object</th>\n                                <th class=\"p-5 font-semibold\">Secondary Object</th>\n                                <th class=\"p-5 font-semibold\">Time of Approach (UTC)</th>\n                                <th class=\"p-5 font-semibold text-right\">Distance (km)</th>\n                                <th class=\"p-5 font-semibold text-center\">Status</th>\n                            </tr>\n                        </thead>\n                        <tbody id=\"conjunctionTableBody\" class=\"divide-y divide-white/5 text-sm\">\n                            <!-- Rows will be injected here via JS -->\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n        </div>\n    </main>\n\n    <script src=\"app.js\"></script>\n</body>\n</html>","Description":"Overhauled the frontend UI to match the cinematic SpaceX style with glassmorphism and animations.","Overwrite":true,"TargetFile":"/Users/anandgopaltiwary/.gemini/antigravity/scratch/space_debris_prototype/frontend/index.html","toolAction":"Overwriting index.html","toolSummary":"Frontend UI overhaul"}}]}
