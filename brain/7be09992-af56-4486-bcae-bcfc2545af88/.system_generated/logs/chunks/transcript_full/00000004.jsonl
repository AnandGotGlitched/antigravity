ider value.\n\n\n","tool_calls":[{"name":"replace_file_content","args":{"AllowMultiple":false,"Description":"Add CAM Drawer to index.html","EndLine":141,"Instruction":"Insert the CAM Drawer just before the closing tag of the viewLive div.","ReplacementContent":"                </div>\n            </div>\n\n            <!-- CAM Drawer (Hidden by default, slides in from right) -->\n            <div id=\"camDrawer\" class=\"fixed top-0 right-0 h-full w-full md:w-96 bg-black/80 backdrop-blur-lg border-l border-white/10 shadow-2xl z-50 transform translate-x-full transition-transform duration-500 flex flex-col p-6\">\n                <div class=\"flex justify-between items-center border-b border-white/10 pb-4 mb-6\">\n                    <h2 class=\"text-lg uppercase tracking-widest font-semibold text-white\">CAM Planner</h2>\n                    <button id=\"closeCamDrawer\" class=\"text-gray-400 hover:text-white transition\">\n                        <i class=\"fa-solid fa-xmark text-xl\"></i>\n                    </button>\n                </div>\n                \n                <div class=\"space-y-6 flex-grow\">\n                    <div>\n                        <p class=\"text-xs uppercase tracking-widest text-gray-400\">Primary Object</p>\n                        <p id=\"camObject1\" class=\"text-lg font-bold text-white tracking-wide\">--</p>\n                    </div>\n                    <div>\n                        <p class=\"text-xs uppercase tracking-widest text-gray-400\">Secondary Object</p>\n                        <p id=\"camObject2\" class=\"text-lg font-bold text-white tracking-wide\">--</p>\n                    </div>\n                    <div class=\"pt-4 border-t border-white/10\">\n                        <div class=\"flex justify-between items-center mb-2\">\n                            <label class=\"text-xs uppercase tracking-wider text-gray-400\">In-Track Delta-v (m/s)</label>\n                            <span id=\"camDeltaVVal\" class=\"t