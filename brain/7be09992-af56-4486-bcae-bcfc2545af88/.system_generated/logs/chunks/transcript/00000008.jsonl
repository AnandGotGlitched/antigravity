{"step_index":420,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-27T17:22:13Z","content":"Created At: 2026-09-27T22:52:13+05:30\nCompleted At: 2026-09-27T22:52:14+05:30\nFile Path: `file:///Users/anandgopaltiwary/.gemini/antigravity/scratch/space_debris_prototype/backend/main.py`\nTotal Lines: 82\nTotal Bytes: 2104\nShowing lines 1 to 82\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: from fastapi import FastAPI\n2: from fastapi.middleware.cors import CORSMiddleware\n3: from pydantic import BaseModel\n4: import math\n5: from sgp4_calc import find_close_approaches, TLE_DATA\n6: \n7: app = FastAPI(title=\"Space Debris Collision Avoidance API\")\n8: \n9: app.add_middleware(\n10:     CORSMiddleware,\n11:     allow_origins=[\"*\"],\n12:     allow_credentials=True,\n13:     allow_methods=[\"*\"],\n14:     allow_headers=[\"*\"],\n15: )\n16: \n17: class MissionRiskRequest(BaseModel):\n18:     altitude_km: float\n19:     area_m2: float\n20:     time_years: float\n21: \n22: @app.get(\"/api/tles\")\n23: def get_tles():\n24:     \"\"\"\n25:     Endpoint to return raw TLE data for 3D visualization.\n26:     \"\"\"\n27:     return {\"tles\": TLE_DATA}\n28: \n29: @app.get(\"/api/conjunctions\")\n30: def get_conjunctions():\n31:     \"\"\"\n32:     Endpoint to trigger the close approach calculation and return the risk-ranked list.\n33:     \"\"\"\n34:     results = find_close_approaches(hours=24, step_minutes=5)\n35:     return {\"conjunctions\": results}\n36: \n37: @app.post(\"/api/mission-risk\")\n38: def calculate_mission_risk(params: MissionRiskRequest):\n39:     \"\"\"\n40:     Calculates the probability of at least one debris impact using the Poisson distribution.\n41:     \"\"\"\n42:     alt = params.altitude_km\n43:     area = params.area_m2\n44:     time = params.time_years\n45:     \n46:     # Debris flux F calculation based on altitude\n47:     if alt < 500:\n48:         flux = 5.0e-5\n49:     elif 500 <= alt <= 900:\n50:         flux = 3.5e-4\n51:     else:\n52:         flux = 1.0e-4\n53:         \n54:     # Expected number of impacts (lambda)\n55:     lam = flux * area * time\n56:     \n57:     # Probability of at least one impact: P = 1 - exp(-lambda)\n58:     prob = 1.0 - math.exp(-lam)\n59:     prob_percent = prob * 100.0\n60:     \n61:     # Risk Rating\n62:     if prob_percent < 1:\n63:         risk_rating = \"LOW\"\n64:     elif prob_percent <= 5:\n65:         risk_rating = \"MODERATE\"\n66:     else:\n67:         risk_rating = \"HIGH\"\n68:     \n69:     return {\n70:         \"altitude_km\": alt,\n71:         \"area_m2\": area,\n72:         \"time_years\": time,\n73:         \"flux_per_m2_year\": flux,\n74:         \"expected_impacts\": lam,\n75:         \"probability_percentage\": prob_percent,\n76:         \"risk_rating\": risk_rating\n77:     }\n78: \n79: if __name__ == \"__main__\":\n80:     import uvicorn\n81:     uvicorn.run(\"main:app\", host=\"127.0.0.1\", port=8000, reload=True)\n82: \nThe above content shows the entire, complete file contents of the requested file.\n"}
