e_approaches` to include conditional high-risk simulations. I'm focusing on calculating P_c, using a combined radius of 0.005 km and uncertainty covariance of 0.5 km.  I'm also adding P_c approximation using a 2D Gaussian probability density.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"\"from fastapi import FastAPI\\nfrom fastapi.middleware.cors import CORSMiddleware\\nfrom pydantic import BaseModel\\nimport math\\nfrom sgp4_calc import find_close_approaches\\n\\napp = FastAPI(title=\\\"Space Debris Collision Avoidance API\\\")\\n\\napp.add_middleware(\\n    CORSMiddleware,\\n    allow_origins=[\\\"*\\\"],\\n    allow_credentials=True,\\n    allow_methods=[\\\"*\\\"],\\n    allow_headers=[\\\"*\\\"],\\n)\\n\\nclass MissionParams(BaseModel):\\n    altitude_km: float\\n    area_m2: float\\n    time_years: float\\n\\n@app.get(\\\"/api/conjunctions\\\")\\ndef get_conjunctions():\\n    \\\"\\\"\\\"\\n    Endpoint to trigger the close approach calculation and return the risk-ranked list.\\n    \\\"\\\"\\\"\\n    results = find_close_approaches(hours=24, step_minutes=5)\\n    return {\\\"conjunctions\\\": results}\\n\\n@app.post(\\\"/api/mission-risk\\\")\\ndef calculate_mission_risk(params: MissionParams):\\n    \\\"\\\"\\\"\\n    Calculates the probability of at least one debris impact using the Poisson distribution.\\n    \\\"\\\"\\\"\\n    alt = params.altitude_km\\n    area = params.area_m2\\n    time = params.time_years\\n    \\n    # Debris flux F calculation based on altitude\\n    # F = 5.0e-5 at 400km, scaling to 3.5e-4 at 800km\\n    f_400 = 5.0e-5\\n    f_800 = 3.5e-4\\n    \\n    if alt <= 400:\\n        flux = f_400 * (alt / 400.0) # linear dropoff below 400km\\n    elif alt >= 800:\\n        flux = f_800 + (alt - 800.0) * 1e-6 # arbitrary slight increase above 800km\\n    else:\\n        flux = f_400 + (alt - 400.0) * (f_800 - f_400) / 400.0\\n        \\n    # Expected number of impacts (lambda)\\n    lam = flux * area * time\\n    \\n    # Probability of at least one impact: P = 1 - exp(-lambda)\\n    prob = 1.0 - math.exp(-lam)\\n    \\n    return {\\n        \\\"flux\\\": flux,\\n        \\\"expected_impacts_lambda\\\": lam,\\n        \\\"probability_of_impact_percent\\\": prob * 100.0\\n    }\\n\\nif __name__ == \\\"__main__\\\":\\n    import uvicorn\\n    uvicorn.run(\\\"main:app\\\", host=\\\"127.0.0.1\\\", port=8000, reload=True)\"","Description":"\"Updated main.py to include the new POST endpoint for Poisson mission risk calculation.\"","Overwrite":"true","TargetFile":"\"/Users/anandgopaltiwary/.gemini/antigravity/scratch/space_debris_prototype/backend/main.py\"","toolAction":"\"Rewriting main.py\"","toolSummary":"\"New API endpoint\""}}]}
